{
  "name": "posterforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "image:plan": "node scripts/generate-image-asset.mjs --dry-run",
    "image:generate": "node scripts/generate-image-asset.mjs",
    "export:check": "tsx scripts/export-pdf.ts --check-only",
    "export:pdf": "tsx scripts/export-pdf.ts",
    "export:pptx:html": "node scripts/export-html-pptx.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "dev:local": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^0.468.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright": "^1.60.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
