{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posterforge.local/poster.schema.json",
  "title": "Poster Project",
  "type": "object",
  "required": ["id", "title", "format", "theme", "layout", "sections", "sources", "claims", "visuals"],
  "properties": {
    "id": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "description": "Schema version string, e.g. posterforge.poster.v1"
    },
    "title": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        }
      }
    },
    "subtitle": {
      "type": "string"
    },
    "format": {
      "type": "object",
      "required": ["size", "orientation"],
      "properties": {
        "size": {
          "enum": ["A0", "A1", "A2", "custom"]
        },
        "orientation": {
          "enum": ["portrait", "landscape"]
        }
      }
    },
    "outputIntent": {
      "enum": ["print", "virtual", "both"],
      "description": "Controls whether QA applies print checks, virtual session checks, or both."
    },
    "theme": {
      "type": "string"
    },
    "palette": {
      "type": "string"
    },
    "layout": {
      "enum": [
        "three-column-academic",
        "results-first",
        "timeline-process",
        "dashboard-poster",
        "comic-strip-narrative",
        "case-study-poster"
      ]
    },
    "audience": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "sourceDocuments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceDocument"
      }
    },
    "sourceSummaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceSummary"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "claimMap": {
      "$ref": "#/$defs/claimMap"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "visuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/visual"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "traces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trace"
      }
    },
    "qaResults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/qaIssue"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": ["mock", "local_file", "web", "research_paper", "confluence", "gitlab", "github"]
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "accessed_at": {
          "type": "string"
        },
        "trust_level": {
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "sourceDocument": {
      "type": "object",
      "required": ["id", "source", "title", "body"],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "sourceSummary": {
      "type": "object",
      "required": ["source_id", "summary"],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "figures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "required": ["id", "source_id", "kind", "text"],
      "properties": {
        "id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "kind": {
          "enum": ["claim", "method", "metric", "figure", "code_summary", "reference"]
        },
        "text": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "confidence": {
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "claimMap": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimMapEntry"
          }
        }
      }
    },
    "claimMapEntry": {
      "type": "object",
      "required": ["claim_id", "claim_text", "source_ids", "evidence_ids", "section_ids"],
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "claim_text": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "section_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "text", "source_ids"],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "type", "title", "blocks"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": ["hero", "background", "methods", "results", "key_findings", "discussion", "timeline", "references", "custom"]
        },
        "title": {
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/sectionLayout"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "sectionLayout": {
      "type": "object",
      "properties": {
        "order": {
          "type": "number"
        },
        "columnSpan": {
          "enum": [1, 2, 3, 4]
        },
        "rowSpan": {
          "enum": [1, 2]
        },
        "emphasis": {
          "enum": ["normal", "featured", "hero"]
        },
        "hidden": {
          "type": "boolean"
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            },
            "claim_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "visual_id"],
          "properties": {
            "type": {
              "const": "visual_ref"
            },
            "visual_id": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            }
          }
        }
      ]
    },
    "visual": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data": {
          "type": "object"
        },
        "options": {
          "type": "object"
        },
        "asset": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "type", "role"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": ["ai_image", "generated_background", "generated_panel", "uploaded_image"]
        },
        "role": {
          "enum": ["atmosphere", "section_art", "background", "comic_panel", "reference"]
        },
        "title": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "palette": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string"
        },
        "width_px": {
          "type": "number"
        },
        "height_px": {
          "type": "number"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "trace": {
      "type": "object",
      "required": ["id", "label", "detail", "status"],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "status": {
          "enum": ["queued", "running", "complete"]
        },
        "timestamp": {
          "type": "string"
        },
        "artifactRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "required": ["kind", "label"],
      "properties": {
        "kind": {
          "enum": [
            "poster_spec",
            "source_index",
            "source_document",
            "evidence_map",
            "claim_map",
            "layout_plan",
            "visual_plan",
            "image_prompt",
            "render",
            "qa_report",
            "export"
          ]
        },
        "label": {
          "type": "string"
        }
      }
    },
    "qaIssue": {
      "type": "object",
      "required": ["id", "severity", "location", "message"],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": ["high", "medium", "low"]
        },
        "location": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedFix": {
          "type": "string"
        },
        "autoFixable": {
          "type": "boolean"
        },
        "fixId": {
          "enum": ["create_references"]
        }
      }
    }
  }
}
