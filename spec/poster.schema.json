{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/poster.schema.json",
  "title": "Poster Project",
  "type": "object",
  "required": ["id", "title", "format", "theme", "layout", "sections", "sources", "claims", "visuals"],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "subtitle": {
      "type": "string"
    },
    "format": {
      "type": "object",
      "required": ["size", "orientation"],
      "properties": {
        "size": {
          "enum": ["A0", "A1", "A2", "custom"]
        },
        "orientation": {
          "enum": ["portrait", "landscape"]
        }
      }
    },
    "theme": {
      "type": "string"
    },
    "palette": {
      "type": "string"
    },
    "layout": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "visuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/visual"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "traces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trace"
      }
    },
    "qaResults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/qaIssue"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": ["mock", "local_file", "web", "research_paper", "confluence", "gitlab"]
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "accessed_at": {
          "type": "string"
        },
        "trust_level": {
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "text", "source_ids"],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "type", "title", "blocks"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": ["hero", "background", "methods", "results", "key_findings", "discussion", "timeline", "references", "custom"]
        },
        "title": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "visual": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data": {
          "type": "object"
        },
        "options": {
          "type": "object"
        },
        "asset": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "type", "role"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": ["ai_image", "generated_background", "generated_panel", "uploaded_image"]
        },
        "role": {
          "enum": ["atmosphere", "section_art", "background", "comic_panel", "reference"]
        },
        "title": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "palette": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string"
        },
        "width_px": {
          "type": "number"
        },
        "height_px": {
          "type": "number"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "trace": {
      "type": "object",
      "required": ["id", "label", "detail", "status"],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "status": {
          "enum": ["queued", "running", "complete"]
        },
        "timestamp": {
          "type": "string"
        },
        "artifactRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "required": ["kind", "label"],
      "properties": {
        "kind": {
          "enum": [
            "poster_spec",
            "source_index",
            "source_document",
            "evidence_map",
            "claim_map",
            "layout_plan",
            "visual_plan",
            "image_prompt",
            "render",
            "qa_report",
            "export"
          ]
        },
        "label": {
          "type": "string"
        }
      }
    },
    "qaIssue": {
      "type": "object",
      "required": ["id", "severity", "location", "message"],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": ["high", "medium", "low"]
        },
        "location": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedFix": {
          "type": "string"
        },
        "autoFixable": {
          "type": "boolean"
        }
      }
    }
  }
}
