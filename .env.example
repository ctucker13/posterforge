# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# Required for AI poster generation via OpenAI
VITE_OPENAI_API_KEY=

# Model to use for poster generation (default: gpt-4o)
# Change to any OpenAI chat model, e.g. gpt-4o-mini, gpt-4-turbo, gpt-5.4
VITE_OPENAI_MODEL=gpt-4o
