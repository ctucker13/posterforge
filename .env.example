# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# Required for AI poster generation via OpenAI
VITE_OPENAI_API_KEY=

# Model to use for poster generation (default: gpt-4o)
# Change to any OpenAI chat model, e.g. gpt-4o-mini, gpt-4-turbo, gpt-5.4
VITE_OPENAI_MODEL=gpt-4o

# Model used for in-canvas image generation (default: gpt-image-2)
VITE_OPENAI_IMAGE_MODEL=gpt-image-2

# Optional: route in-canvas image generation to a self-hosted service instead
# of calling OpenAI directly from the browser. When set, the canvas POSTs
# { model, prompt, size, output_format, background } to this URL and expects
# a JSON response containing { b64_json } (or { data: [{ b64_json }] }).
# Leave blank to call OpenAI directly using VITE_OPENAI_API_KEY.
# VITE_IMAGEGEN_URL=http://localhost:8000/generate
